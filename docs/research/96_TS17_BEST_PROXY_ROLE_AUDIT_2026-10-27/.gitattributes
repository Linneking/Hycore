# Preserve exported artifact bytes so server SHA manifests survive checkouts.
results/** -text
# Matplotlib SVG path commands include intentional trailing spaces.
results/**/*.svg whitespace=-blank-at-eol
# Standard CSV writer uses CRLF row endings.
results/*.csv whitespace=cr-at-eol

# Frozen outer-proxy followup exports.
outer_results/** -text
outer_results/**/*.svg whitespace=-blank-at-eol
outer_results/*.csv whitespace=cr-at-eol
